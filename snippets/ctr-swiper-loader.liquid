{%- comment -%}
  CTR Swiper Loader
  ─────────────────────────────────────────────────────────────────────────────
  Rendered once before </body> by layout/theme.liquid.

  Any section that needs Swiper must:
    1.  Set  {% assign ctr_swiper_needed = true %}  at the top of the file.
    2.  Register its init callback before this snippet runs:

        <script>
          window._ctrSwiperQ = window._ctrSwiperQ || [];
          window._ctrSwiperQ.push(function () {
            var el = document.getElementById('my-swiper-id');
            if (!el || el._sw) return;
            el._sw = new Swiper(el, { ... });
          });
        </script>

  This snippet then loads Swiper (CSS + JS) once, synchronously, and executes
  every queued callback. No race conditions, no duplicate requests.
{%- endcomment -%}

{% if ctr_swiper_needed %}
  {{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      (window._ctrSwiperQ || []).forEach(function (fn) { fn(); });
    });
  </script>
{% endif %}
