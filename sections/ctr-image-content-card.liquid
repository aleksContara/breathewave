{%- comment -%} Image Content Card — ctr-image-content-card.liquid {%- endcomment -%}
{%- liquid
  assign custom_css      = section.settings.custom_css
  assign section_id_attr = section.settings.section_id

  comment
    Map content_position to CSS flex values
  endcomment
  case section.settings.content_position
    when 'top-left'
      assign pos_justify = 'flex-start'
      assign pos_align   = 'flex-start'
    when 'top-center'
      assign pos_justify = 'center'
      assign pos_align   = 'flex-start'
    when 'top-right'
      assign pos_justify = 'flex-end'
      assign pos_align   = 'flex-start'
    when 'center-left'
      assign pos_justify = 'flex-start'
      assign pos_align   = 'center'
    when 'center'
      assign pos_justify = 'center'
      assign pos_align   = 'center'
    when 'center-right'
      assign pos_justify = 'flex-end'
      assign pos_align   = 'center'
    when 'bottom-right'
      assign pos_justify = 'flex-end'
      assign pos_align   = 'flex-end'
    when 'bottom-center'
      assign pos_justify = 'center'
      assign pos_align   = 'flex-end'
    else
      assign pos_justify = 'flex-start'
      assign pos_align   = 'flex-end'
  endcase
-%}

{% capture selector %}[data-style-id="{{ section.id }}"]{% endcapture %}

{% capture css %}
  & {
    {% if section.settings.section_bg != blank and section.settings.section_bg.alpha != 0 %}
      background-color: {{ section.settings.section_bg }};
    {% endif %}
    padding: {{ section.settings.padding_v }}px {{ section.settings.padding_h }}px;
    box-sizing: border-box;
  }

  & .icc__inner {
    max-width: {{ section.settings.card_max_width }}px;
    margin: 0 auto;
  }

  /* ── Card ── */
  & .icc__card {
    position: relative;
    overflow: hidden;
    border-radius: {{ section.settings.card_radius }}px;
    min-height: {{ section.settings.min_height_mobile }}px;
    display: flex;
    flex-direction: column;
    {% if section.settings.card_bg != blank and section.settings.card_bg.alpha != 0 %}
      background-color: {{ section.settings.card_bg }};
    {% endif %}
  }

  /* ── Background images ── */
  & .icc__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.bg_position_mobile }};
    z-index: 0;
  }
  & .icc__bg--desktop { display: none; }
  & .icc__bg--mobile  { display: block; }

  /* ── Gradient overlay ── */
  & .icc__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: {{ section.settings.overlay_opacity | times: 0.01 }};
    {% if section.settings.overlay_direction == 'none' %}
      display: none;
    {% elsif section.settings.overlay_direction == 'fill' %}
      background: {{ section.settings.overlay_color }};
    {% elsif section.settings.overlay_direction == 'left' %}
      background: linear-gradient(to right, {{ section.settings.overlay_color }}, transparent 70%);
    {% elsif section.settings.overlay_direction == 'right' %}
      background: linear-gradient(to left, {{ section.settings.overlay_color }}, transparent 70%);
    {% elsif section.settings.overlay_direction == 'top' %}
      background: linear-gradient(to bottom, {{ section.settings.overlay_color }}, transparent 70%);
    {% elsif section.settings.overlay_direction == 'bottom' %}
      background: linear-gradient(to top, {{ section.settings.overlay_color }}, transparent 70%);
    {% endif %}
  }

  /* ── Content positioning ── */
  & .icc__content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: {{ pos_align }};
    justify-content: {{ pos_justify }};
    padding: {{ section.settings.content_padding_mobile }}px;
    box-sizing: border-box;
  }

  & .icc__content-inner {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.content_gap }}px;
    max-width: {{ section.settings.content_width_mobile }}%;
    width: 100%;
  }

  /* ── Eyebrow ── */
  & .icc__eyebrow {
    display: block;
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0;
    {% if section.settings.eyebrow_color != blank and section.settings.eyebrow_color.alpha != 0 %}
      color: {{ section.settings.eyebrow_color }};
    {% endif %}
  }

  /* ── Heading ── */
  & .icc__heading {
    font-size: {{ section.settings.heading_size_mobile }}px;
    font-weight: 300;
    line-height: 1.1;
    margin: 0;
    {% if section.settings.heading_color != blank and section.settings.heading_color.alpha != 0 %}
      color: {{ section.settings.heading_color }};
    {% endif %}
  }
  & .icc__heading h1,
  & .icc__heading h2,
  & .icc__heading h3,
  & .icc__heading p {
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    color: inherit;
    margin: 0;
  }

  /* ── Body ── */
  & .icc__body {
    font-size: {{ section.settings.body_size_mobile }}px;
    line-height: 1.6;
    font-weight: 300;
    margin: 0;
    {% if section.settings.body_color != blank and section.settings.body_color.alpha != 0 %}
      color: {{ section.settings.body_color }};
    {% endif %}
  }
  & .icc__body p   { margin: 0; }
  & .icc__body sup {
    font-size: 0.65em;
    vertical-align: super;
    line-height: 0;
    opacity: 0.65;
  }

  /* ── CTA ── */
  & .icc__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ section.settings.cta_padding_v }}px {{ section.settings.cta_padding_h }}px;
    border-radius: {{ section.settings.cta_radius }}px;
    font-size: {{ section.settings.cta_size }}px;
    font-weight: {{ section.settings.cta_weight }};
    text-decoration: none;
    width: max-content;
    transition: opacity 0.2s;
    margin-top: 4px;
  }
  & .icc__cta:hover { opacity: 0.88; }

  /* ── Desktop ── */
  @media (min-width: 768px) {
    & .icc__card {
      min-height: {{ section.settings.min_height_desktop }}px;
    }
    & .icc__bg {
      object-position: {{ section.settings.bg_position_desktop }};
    }
    & .icc__bg--desktop { display: block; }
    & .icc__bg--mobile  { display: none; }
    & .icc__content {
      padding: {{ section.settings.content_padding_desktop }}px;
    }
    & .icc__content-inner {
      max-width: {{ section.settings.content_width_desktop }}px;
    }
    & .icc__heading {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }
    & .icc__body {
      font-size: {{ section.settings.body_size_desktop }}px;
    }
  }
{% endcapture %}

<style>
  {{ css | append: custom_css | replace: '&', selector | strip_newlines }}
</style>

{%- comment -%} Per-block styles — size + color per block {%- endcomment -%}
{%- for block in section.blocks -%}
  {%- assign blk = section.id | append: '-' | append: block.id -%}

  {%- if block.type == 'eyebrow' -%}
    <style>[data-icc-block="{{ blk }}"] { font-size: {{ block.settings.size }}px; }</style>

  {%- elsif block.type == 'heading' -%}
    <style>
      [data-icc-block="{{ blk }}"] { font-size: {{ block.settings.size_mobile }}px; }
      @media (min-width: 768px) { [data-icc-block="{{ blk }}"] { font-size: {{ block.settings.size_desktop }}px; } }
    </style>

  {%- elsif block.type == 'body' -%}
    <style>
      [data-icc-block="{{ blk }}"] { font-size: {{ block.settings.size_mobile }}px; }
      @media (min-width: 768px) { [data-icc-block="{{ blk }}"] { font-size: {{ block.settings.size_desktop }}px; } }
    </style>

  {%- elsif block.type == 'cta' -%}
    <style>
      [data-icc-block="{{ blk }}"] {
        {% if block.settings.cta_bg != blank and block.settings.cta_bg.alpha != 0 %}background-color: {{ block.settings.cta_bg }};{% endif %}
        {% if block.settings.cta_color != blank and block.settings.cta_color.alpha != 0 %}color: {{ block.settings.cta_color }};{% endif %}
        font-size: {{ block.settings.size }}px;
      }
    </style>

  {%- endif -%}
{%- endfor -%}

<div
  data-style-id="{{ section.id }}"
  {% if section_id_attr != blank %}id="{{ section_id_attr }}"{% endif %}
>
  <div class="icc__inner">
    <div class="icc__card">

      {%- comment -%} Background images {%- endcomment -%}
      {%- if section.settings.bg_image_mobile != blank -%}
        <img
          class="icc__bg icc__bg--mobile"
          src="{{ section.settings.bg_image_mobile | image_url: width: 1200 }}"
          alt=""
          loading="lazy"
          width="{{ section.settings.bg_image_mobile.width }}"
          height="{{ section.settings.bg_image_mobile.height }}"
        >
      {%- elsif section.settings.bg_image_desktop != blank -%}
        <img
          class="icc__bg icc__bg--mobile"
          src="{{ section.settings.bg_image_desktop | image_url: width: 1200 }}"
          alt=""
          loading="lazy"
          width="{{ section.settings.bg_image_desktop.width }}"
          height="{{ section.settings.bg_image_desktop.height }}"
        >
      {%- endif -%}

      {%- if section.settings.bg_image_desktop != blank -%}
        <img
          class="icc__bg icc__bg--desktop"
          src="{{ section.settings.bg_image_desktop | image_url: width: 2400 }}"
          alt=""
          loading="lazy"
          width="{{ section.settings.bg_image_desktop.width }}"
          height="{{ section.settings.bg_image_desktop.height }}"
        >
      {%- endif -%}

      {%- comment -%} Gradient overlay {%- endcomment -%}
      {%- if section.settings.overlay_direction != 'none' -%}
        <div class="icc__overlay"></div>
      {%- endif -%}

      {%- comment -%} Content {%- endcomment -%}
      <div class="icc__content">
        <div class="icc__content-inner">

          {%- for block in section.blocks -%}

            {%- assign blk = section.id | append: '-' | append: block.id -%}

            {%- if block.type == 'eyebrow' and block.settings.text != blank -%}
              <span class="icc__eyebrow" data-icc-block="{{ blk }}" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </span>

            {%- elsif block.type == 'heading' and block.settings.heading != blank -%}
              <div class="icc__heading" data-icc-block="{{ blk }}" {{ block.shopify_attributes }}>
                {{ block.settings.heading }}
              </div>

            {%- elsif block.type == 'body' and block.settings.text != blank -%}
              <div class="icc__body" data-icc-block="{{ blk }}" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>

            {%- elsif block.type == 'cta' and block.settings.label != blank -%}
              <a
                href="{{ block.settings.url }}"
                class="icc__cta"
                data-icc-block="{{ blk }}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.label }}
              </a>

            {%- endif -%}

          {%- endfor -%}

        </div>
      </div>

    </div>
  </div>
</div>

