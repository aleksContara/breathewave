{%- comment -%} Comparison Cards Section {%- endcomment -%}
{%- liquid
  assign custom_css      = section.settings.custom_css
  assign section_id_attr = section.settings.section_id
-%}

{% capture selector %}[data-style-id="{{ section.id }}"]{% endcapture %}

{% capture css %}
  & {
    {% if section.settings.bg_color != blank and section.settings.bg_color.alpha != 0 %}
      background-color: {{ section.settings.bg_color }};
    {% endif %}
    padding: {{ section.settings.padding_v }}px {{ section.settings.padding_h }}px;
    box-sizing: border-box;
  }

  & .cc__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  & .cc__header {
    margin-bottom: {{ section.settings.header_gap }}px;
  }

  & .cc__eyebrow {
    display: block;
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 10px;
    {% if section.settings.eyebrow_color != blank and section.settings.eyebrow_color.alpha != 0 %}
      color: {{ section.settings.eyebrow_color }};
    {% endif %}

    @media (max-width: 767px) {
      text-align: center;
    }
  }

  & .cc__heading {
    font-family: 'Nohemi';
    font-size: {{ section.settings.heading_size_mobile }}px;
    font-weight: 400;
    line-height: 1.2;
    margin: 0;
    {% if section.settings.heading_color != blank and section.settings.heading_color.alpha != 0 %}
      color: {{ section.settings.heading_color }};
    {% endif %}

    @media (max-width: 767px) {
      text-align: center;
    }
  }
  & .cc__heading h1, & .cc__heading h2, & .cc__heading h3, & .cc__heading p {
    font-size: inherit; font-weight: inherit; line-height: inherit; color: inherit; margin: 0;
  }

  & .cc__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.card_gap }}px;
  }

  & .cc__card {
    display: flex;
    flex-direction: column;
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    {% if section.settings.card_bg != blank and section.settings.card_bg.alpha != 0 %}
      background-color: {{ section.settings.card_bg }};
    {% endif %}
    {% if section.settings.card_border != blank and section.settings.card_border.alpha != 0 %}
      border: 1px solid {{ section.settings.card_border }};
    {% endif %}
  }

  & .cc__card-image-wrap {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ section.settings.image_padding }}px;
    box-sizing: border-box;
    {% if section.settings.image_bg != blank and section.settings.image_bg.alpha != 0 %}
      background-color: {{ section.settings.image_bg }};
    {% endif %}
    min-height: {{ section.settings.image_min_height }}px;
  }
  & .cc__card-image-wrap img {
    display: block;
    max-width: 100%;
    max-height: {{ section.settings.image_min_height }}px;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  & .cc__card-body {
    padding: {{ section.settings.body_padding }}px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  & .cc__card-title-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  & .cc__card-icon {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  & .cc__card-icon svg {
    display: block;
    width: 28px;
    height: 28px;
  }

  & .cc__card-title {
    font-size: {{ section.settings.title_size }}px;
    font-weight: 400;
    line-height: 1.2;
    margin: 0;
    {% if section.settings.title_color != blank and section.settings.title_color.alpha != 0 %}
      color: {{ section.settings.title_color }};
    {% endif %}
  }

  & .cc__card-bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;

    @media (max-width: 767px) {
      gap: 2px;
    }
  }
  & .cc__card-bullets li {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: {{ section.settings.bullet_size }}px;
    line-height: 1.5;
    {% if section.settings.bullet_color != blank and section.settings.bullet_color.alpha != 0 %}
      color: {{ section.settings.bullet_color }};
    {% endif %}
  }
  & .cc__card-bullets li::before {
    content: '•';
    flex-shrink: 0;
    {% if section.settings.bullet_color != blank and section.settings.bullet_color.alpha != 0 %}
      color: {{ section.settings.bullet_color }};
    {% endif %}
  }
  & .cc__card-bullets sup {
    font-size: 0.65em;
    vertical-align: super;
    line-height: 0;
    opacity: 0.6;
  }

  @media (min-width: 768px) {
    & .cc__heading {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }
    & .cc__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endcapture %}

<style>
  {{ css | append: custom_css | replace: '&', selector | strip_newlines }}
</style>

<div
  data-style-id="{{ section.id }}"
  {% if section_id_attr != blank %}id="{{ section_id_attr }}"{% endif %}
>
  <div class="cc__inner">

    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="cc__header">
        {%- if section.settings.eyebrow != blank -%}
          <span class="cc__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <div class="cc__heading">{{ section.settings.heading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="cc__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'comparison_card' -%}
          <div class="cc__card" {{ block.shopify_attributes }}>

            {%- comment -%} Image area {%- endcomment -%}
            {%- if block.settings.image != blank -%}
              <div class="cc__card-image-wrap">
                <img
                  src="{{ block.settings.image | image_url: width: 900 }}"
                  alt="{{ block.settings.image.alt | default: block.settings.title }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              </div>
            {%- endif -%}

            {%- comment -%} Body {%- endcomment -%}
            <div class="cc__card-body">

              <div class="cc__card-title-row">
                <div class="cc__card-icon">
                  {%- if block.settings.status == 'check' -%}
                    <svg viewBox="0 0 28 28" fill="none">
                      <circle cx="14" cy="14" r="13" stroke="{{ block.settings.icon_color | default: '#22c55e' }}" stroke-width="2"/>
                      <path d="M8 14l4 4 8-8" stroke="{{ block.settings.icon_color | default: '#22c55e' }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {%- else -%}
                    <svg viewBox="0 0 28 28" fill="none">
                      <circle cx="14" cy="14" r="13" stroke="{{ block.settings.icon_color | default: '#ef4444' }}" stroke-width="2"/>
                      <path d="M9.5 9.5l9 9M18.5 9.5l-9 9" stroke="{{ block.settings.icon_color | default: '#ef4444' }}" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                  {%- endif -%}
                </div>
                {%- if block.settings.title != blank -%}
                  <div class="cc__card-title">{{ block.settings.title }}</div>
                {%- endif -%}
              </div>

              {%- comment -%} Bullet list {%- endcomment -%}
              {%- assign has_bullets = false -%}
              {%- for n in (1..8) -%}
                {%- assign key = 'bullet_' | append: n -%}
                {%- if block.settings[key] != blank -%}{%- assign has_bullets = true -%}{%- endif -%}
              {%- endfor -%}

              {%- if has_bullets -%}
                <ul class="cc__card-bullets">
                  {%- for n in (1..8) -%}
                    {%- assign key = 'bullet_' | append: n -%}
                    {%- if block.settings[key] != blank -%}
                      <li>{{ block.settings[key] }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}

            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Comparison Cards",
  "settings": [
    {
      "type": "header",
      "content": "Section Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "EXTERNAL vs INTERNAL"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>See why internal is better: more comfort, more airflow, zero hassle.</p>"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size — Desktop (px)",
      "default": 36,
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size — Mobile (px)",
      "default": 24,
      "min": 16,
      "max": 44,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "header_gap",
      "label": "Gap after heading (px)",
      "default": 40,
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "paragraph",
      "content": "t:all.empty_char"
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "max_width",
