        },
        {
          "type": "text",
          "id": "bullet_4",
          "label": "Bullet 4"
        },
        {
          "type": "text",
          "id": "bullet_5",
          "label": "Bullet 5"
        },
        {
          "type": "text",
          "id": "bullet_6",
          "label": "Bullet 6"
        },
        {
          "type": "text",
          "id": "bullet_7",
          "label": "Bullet 7"
        },
        {
          "type": "text",
          "id": "bullet_8",
          "label": "Bullet 8"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CTR Comparison Cards",
      "category": "Comparison",
      "blocks": [
        {
          "type": "comparison_card",
          "settings": {
            "status": "x",
            "icon_color": "#ef4444",
            "title": "External - Pull (Resists)",
            "bullet_1": "Magnets, glues, and gadgets that pull from outside",
            "bullet_2": "Pulls on skin, not the airway itself",
            "bullet_3": "Adhesive weakens, slips and may cause irritation",
            "bullet_4": "Nasal valve still collapses during inhalation"
          }
        },
        {
          "type": "comparison_card",
          "settings": {
            "status": "check",
            "icon_color": "#22c55e",
            "title": "Internal - Lift (Releases)",
            "bullet_1": "Mechanically opens the nasal valve from within",
            "bullet_2": "Support of airway allows for more airflow",
