      "max": 120,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_h",
      "label": "Section padding horizontal (px)",
      "default": 24,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards (px)",
      "default": 24,
      "min": 8,
      "max": 60,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "paragraph",
      "content": "t:all.empty_char"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "bg_color",
      "label": "Section background",
      "default": "#eef1f8"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#444444"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "heading_color",
      "label": "Heading color",
