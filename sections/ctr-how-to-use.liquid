{%- comment -%} How To Use Section {%- endcomment -%}
{%- liquid
  assign custom_css      = section.settings.custom_css
  assign section_id_attr = section.settings.section_id
-%}

{% capture selector %}[data-style-id="{{ section.id }}"]{% endcapture %}

{% capture css %}
  & {
    {% if section.settings.section_bg != blank and section.settings.section_bg.alpha != 0 %}
      background-color: {{ section.settings.section_bg }};
    {% endif %}
    padding: {{ section.settings.section_padding_v }}px {{ section.settings.section_padding_h }}px;
    box-sizing: border-box;
  }

  & .htu__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  & .htu__card {
    {% if section.settings.card_bg != blank and section.settings.card_bg.alpha != 0 %}
      background-color: {{ section.settings.card_bg }};
    {% endif %}
    border-radius: 32px;
    padding: {{ section.settings.card_padding_v }}px {{ section.settings.card_padding_h }}px;
    box-sizing: border-box;
  }

  & .htu__header {
    text-align: center;
    margin-bottom: {{ section.settings.header_gap }}px;
  }

  & .htu__eyebrow {
    display: block;
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 10px;
    {% if section.settings.eyebrow_color != blank and section.settings.eyebrow_color.alpha != 0 %}
      color: {{ section.settings.eyebrow_color }};
    {% endif %}
  }

  & .htu__heading {
    font-family: 'Nohemi';
    font-size: {{ section.settings.heading_size_mobile }}px;
    font-weight: 400;
    line-height: 1.15;
    margin: 0;
    {% if section.settings.heading_color != blank and section.settings.heading_color.alpha != 0 %}
      color: {{ section.settings.heading_color }};
    {% endif %}
  }
  & .htu__heading h1,
  & .htu__heading h2,
  & .htu__heading h3,
  & .htu__heading p {
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    color: inherit;
    margin: 0;
  }

  & .htu__steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.steps_gap }}px;
    margin-bottom: {{ section.settings.note_gap }}px;
  }

  & .htu__step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
  }

  & .htu__step-image-wrap {
    width: 100%;
    overflow: hidden;
    {% comment %} border: 1px solid {{ section.settings.step_card_border }}; {% endcomment %}
    line-height: 0;
    background: {{ section.settings.step_card_bg }};
  }

  & .htu__step-image-wrap img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  & .htu__step-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  & .htu__step-label {
    font-size: {{ section.settings.label_size }}px;
    font-weight: 400;
    margin: 0;
    {% if section.settings.label_color != blank and section.settings.label_color.alpha != 0 %}
      color: {{ section.settings.label_color }};
    {% endif %}
  }

  & .htu__step-desc {
    font-size: {{ section.settings.desc_size }}px;
    line-height: 1.55;
    margin: 0;
    max-width: 300px;
    {% if section.settings.desc_color != blank and section.settings.desc_color.alpha != 0 %}
      color: {{ section.settings.desc_color }};
    {% endif %}
  }
  & .htu__step-desc p { margin: 0; }

  @media (max-width: 767px) {
    & .htu__step {
      flex-direction: row;
      align-items: flex-start;
      text-align: left;
    }
    & .htu__step-image-wrap {
      width: 135px;
      flex-shrink: 0;
    }
    & .htu__step-text {
      flex: 1;
      min-width: 0;
      align-items: flex-start;
    }
    & .htu__step-desc {
      max-width: none;
    }
  }

  & .htu__note {
    text-align: center;
    font-size: {{ section.settings.note_size }}px;
    line-height: 1.6;
    {% if section.settings.note_color != blank and section.settings.note_color.alpha != 0 %}
      color: {{ section.settings.note_color }};
    {% endif %}
  }
  & .htu__note p { margin: 0; }

  @media (min-width: 768px) {
    & .htu__heading {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }
    & .htu__steps {
      grid-template-columns: repeat({{ section.settings.desktop_cols }}, 1fr);
    }
  }
{% endcapture %}

<style>
  {{ css | append: custom_css | replace: '&', selector | strip_newlines }}
</style>

<div
  data-style-id="{{ section.id }}"
  {% if section_id_attr != blank %}id="{{ section_id_attr }}"{% endif %}
>
  <div class="htu__inner">
    <div class="htu__card">

      {%- comment -%} Header {%- endcomment -%}
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
        <div class="htu__header">
          {%- if section.settings.eyebrow != blank -%}
            <span class="htu__eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <div class="htu__heading">{{ section.settings.heading }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} Steps {%- endcomment -%}
      {%- assign step_blocks = section.blocks | where: 'type', 'step' -%}
      {%- if step_blocks.size > 0 -%}
        <div class="htu__steps">
          {%- for block in step_blocks -%}
            <div class="htu__step" {{ block.shopify_attributes }}>

              {%- if block.settings.image != blank -%}
                <div class="htu__step-image-wrap">
                  <img
                    src="{{ block.settings.image | image_url: width: 800 }}"
                    alt="{{ block.settings.image.alt | default: block.settings.step_label }}"
                    loading="lazy"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                  >
                </div>
              {%- endif -%}

              <div class="htu__step-text">
                {%- if block.settings.step_label != blank -%}
                  <div class="htu__step-label">{{ block.settings.step_label }}</div>
                {%- endif -%}

                {%- if block.settings.description != blank -%}
                  <div class="htu__step-desc">{{ block.settings.description }}</div>
                {%- endif -%}
              </div>

            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} Note blocks {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'note' and block.settings.text != blank -%}
          <div class="htu__note" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </div>
        {%- endif -%}
      {%- endfor -%}

    </div>
  </div>
</div>

