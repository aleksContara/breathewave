{%- comment -%} Instagram Feed - ctr-instagram-grid.liquid {%- endcomment -%}
{% assign ctr_swiper_needed = true %}
{%- liquid
  assign section_id_attr = section.settings.section_id
  assign custom_css = section.settings.custom_css
  assign app_blocks = section.blocks | where: 'type', '@app'
  assign image_blocks = section.blocks | where: 'type', 'image'
  assign swiper_id = 'ig-swiper-' | append: section.id
-%}

{% capture selector %}[data-style-id="{{ section.id }}"]{% endcapture %}

{% capture css %}
  & {
    {% if section.settings.bg_color != blank and section.settings.bg_color.alpha != 0 %}
      background-color: {{ section.settings.bg_color }};
    {% endif %}
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;
    box-sizing: border-box;
  }

  & .ig__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  & .ig__heading {
    margin: 0 0 {{ section.settings.heading_gap }}px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_desktop }}px;
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: 0;
  }

  & .ig__handle {
    color: {{ section.settings.handle_color }};
  }

  & .ig__app {
    width: 100%;
  }

  & .ig__grid {
    overflow: hidden;
    position: relative;
  }

  /* Desktop: override Swiper → CSS grid */
  @media (min-width: 750px) {
    & .ig__grid {
      overflow: visible;
    }
    & .ig__grid .swiper-wrapper {
      display: grid !important;
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
      gap: {{ section.settings.gap }}px;
      transform: none !important;
      transition: none !important;
      will-change: auto !important;
    }
    & .ig__grid .swiper-slide {
      width: auto !important;
      height: auto !important;
      margin-right: 0 !important;
    }
  }

  & .ig__item {
    display: block;
    aspect-ratio: {{ section.settings.image_aspect }};
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    background: #d8dde8;
    color: inherit;
    text-decoration: none;
  }

  & .ig__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  & .ig__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: rgba(15, 15, 15, 0.18);
  }

  & .ig__placeholder svg {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 749px) {
    & {
      padding: {{ section.settings.padding_top_mobile }}px {{ section.settings.padding_horizontal_mobile }}px {{ section.settings.padding_bottom_mobile }}px;
    }

    & .ig__heading {
      margin-bottom: {{ section.settings.heading_gap_mobile }}px;
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    /* mobile layout handled by Swiper */
  }
{% endcapture %}

<style>
  {{ css | append: custom_css | replace: '&', selector | strip_newlines }}
</style>

<div
  data-style-id="{{ section.id }}"
  {% if section_id_attr != blank %}id="{{ section_id_attr }}"{% endif %}
>
  <div class="ig__inner">
    {%- if section.settings.heading != blank or section.settings.handle_text != blank -%}
      <h2 class="ig__heading">
        {%- if section.settings.heading != blank -%}
          <span>{{ section.settings.heading }}</span>
        {%- endif -%}
        {%- if section.settings.handle_text != blank -%}
          <span class="ig__handle">{{ section.settings.handle_text }}</span>
        {%- endif -%}
      </h2>
    {%- endif -%}

    {%- if app_blocks.size > 0 -%}
      <div class="ig__app">
        {%- content_for 'blocks' -%}
      </div>
    {%- else -%}
      <div class="ig__grid swiper" id="{{ swiper_id }}">
        <div class="swiper-wrapper">
          {%- if image_blocks.size > 0 -%}
            {%- for block in image_blocks -%}
              {%- liquid
                assign image_url = block.settings.link
                if image_url == blank
                  assign image_url = section.settings.handle_link
                endif
              -%}

              {%- if image_url != blank -%}
                <a class="ig__item swiper-slide" href="{{ image_url }}" {{ block.shopify_attributes }}>
              {%- else -%}
                <div class="ig__item swiper-slide" {{ block.shopify_attributes }}>
              {%- endif -%}

                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '320, 480, 640, 800, 900',
                      sizes: '(min-width: 990px) 20vw, 50vw',
                      class: 'ig__image'
                  }}
                {%- else -%}
                  <div class="ig__placeholder">
                    {{ 'lifestyle-1' | placeholder_svg_tag }}
                  </div>
                {%- endif -%}

              {%- if image_url != blank -%}
                </a>
              {%- else -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..section.settings.placeholder_count) -%}
              <div class="ig__item swiper-slide">
                <div class="ig__placeholder">
                  {{ 'lifestyle-1' | placeholder_svg_tag }}
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var SWIPER_JS  = {{ 'swiper-bundle.min.js'  | asset_url | json }};
    var SWIPER_CSS = {{ 'swiper-bundle.min.css' | asset_url | json }};
    var SWIPER_ID  = {{ swiper_id | json }};
    var GAP        = {{ section.settings.gap_mobile }};

    function initSwiper() {
      var el = document.getElementById(SWIPER_ID);
      if (!el) return;

      var mql = window.matchMedia('(max-width: 749px)');

      function update(e) {
        if (e.matches) {
          if (!el._sw) {
            el._sw = new Swiper(el, {
              slidesPerView: 2.5,
              spaceBetween: GAP,
              grabCursor: true,
            });
          }
        } else {
          if (el._sw) {
            el._sw.destroy(true, true);
            el._sw = null;
          }
        }
      }

      mql.addEventListener('change', update);
      update(mql);
    }

    if (window.Swiper) { initSwiper(); return; }

    window._ctrSwiperCBs = window._ctrSwiperCBs || [];
    window._ctrSwiperCBs.push(initSwiper);

    if (document.getElementById('ctr-swiper-js')) return;

    if (!document.getElementById('ctr-swiper-css')) {
      var l = document.createElement('link');
      l.id = 'ctr-swiper-css'; l.rel = 'stylesheet'; l.href = SWIPER_CSS;
      document.head.appendChild(l);
    }

    var s = document.createElement('script');
    s.id  = 'ctr-swiper-js';
    s.src = SWIPER_JS;
    s.onload = function () {
      (window._ctrSwiperCBs || []).forEach(function (fn) { fn(); });
    };
    document.head.appendChild(s);
  })();
</script>

{% schema %}
{
  "name": "CTR Instagram Grid",
  "class": "ctr-instagram-grid",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "follow us"
    },
    {
      "type": "text",
      "id": "handle_text",
      "label": "Handle text",
      "default": "@breathewave"
    },
    {
      "type": "text",
      "id": "handle_link",
      "label": "Default image link",
      "default": "https://www.instagram.com/breathewave/"
    },
    {
      "type": "range",
      "id": "placeholder_count",
      "label": "Placeholder count",
      "min": 4,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 960,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1680
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 4,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Mobile gap",
      "min": 6,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "text",
      "id": "image_aspect",
      "label": "Image aspect ratio",
      "default": "1 / 1"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image radius",
      "min": 0,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size desktop",
      "min": 32,
      "max": 84,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size mobile",
      "min": 28,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "heading_gap",
      "label": "Heading gap",
      "min": 20,
      "max": 90,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "heading_gap_mobile",
      "label": "Mobile heading gap",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "handle_color",
      "label": "Handle",
      "default": "#c8cedd"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "label": "Mobile horizontal",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "liquid",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "CTR Instagram Grid",
      "category": "Media",
      "blocks": {
        "image_1": {
          "type": "image"
        },
        "image_2": {
          "type": "image"
        },
        "image_3": {
          "type": "image"
        },
        "image_4": {
          "type": "image"
        },
        "image_5": {
          "type": "image"
        }
      },
      "block_order": ["image_1", "image_2", "image_3", "image_4", "image_5"]
    }
  ]
}
{% endschema %}
