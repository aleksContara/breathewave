{%- comment -%} CTR PDP Features / Big Icons (#features) {%- endcomment -%}
{%- liquid
  assign pdp_product = product
  if pdp_product == blank and closest.product != blank
    assign pdp_product = closest.product
  endif
  assign custom_css = section.settings.custom_css
  assign section_id_attr = section.settings.section_id
  assign content_source = section.settings.content_source
-%}

{% capture selector %}[data-style-id="{{ section.id }}"]{% endcapture %}

{% capture css %}
  & {
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;
    box-sizing: border-box;
    {% if section.settings.bg_color != blank and section.settings.bg_color.alpha != 0 %}background-color: {{ section.settings.bg_color }};{% endif %}
  }
  & .pdp-feat__grid {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    align-items: flex-start;
    position: relative;
  }
  @media (max-width: 767px) {
    & .pdp-feat__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 48px 24px;
    }
    & .pdp-feat__grid::before {
      content: '';
      position: absolute;
      width: calc(100% - 48px);
      top: 50%;
      transform: translateY(-50%);
      height: 1px;
      background: #e4e5f0;
      left: 24px;
    }
  }
  & .pdp-feat__item { display: flex; flex-direction: column; gap: 16px; align-items: center; text-align: center; }
  @media (max-width: 767px) { & .pdp-feat__item { align-items: flex-start; text-align: left; } }
  & .pdp-feat__icon { width: 64px; height: 64px; object-fit: contain; }
  @media (max-width: 767px) { & .pdp-feat__icon { width: 32px; height: 32px; } }
  & .pdp-feat__caption { color: #5f6078; }
  & .pdp-feat__caption h4 { color: #0a0b0c; margin: 0 0 16px; }
  @media (max-width: 767px) { & .pdp-feat__caption h4 { text-align: left; } }
{% endcapture %}

<style>{{ css | append: custom_css | replace: '&', selector | strip_newlines }}</style>

<div data-style-id="{{ section.id }}" {% if section_id_attr != blank %}id="{{ section_id_attr }}"{% endif %} class="pdp-feat">
  <div class="pdp-feat__grid">
    {%- if content_source == 'metafield' and pdp_product.metafields.smart.features.value != blank -%}
      {%- for feature in pdp_product.metafields.smart.features.value -%}
        <div class="pdp-feat__item">
          {%- if feature.image != blank -%}
            <img class="pdp-feat__icon" src="{{ feature.image | image_url: width: 128 }}" alt="" width="64" height="64" loading="lazy">
          {%- endif -%}
          <div class="pdp-feat__caption richtext-md">{{ feature.caption | metafield_tag }}</div>
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'feature' -%}
          <div class="pdp-feat__item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <img class="pdp-feat__icon" src="{{ block.settings.icon | image_url: width: 128 }}" alt="" width="64" height="64" loading="lazy">
            {%- endif -%}
            <div class="pdp-feat__caption richtext-md">
              {%- if block.settings.heading != blank -%}<h4>{{ block.settings.heading }}</h4>{%- endif -%}
              {%- if block.settings.body != blank -%}{{ block.settings.body }}{%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "CTR PDP Features",
  "tag": "section",
  "class": "ctr-pdp-features-section",
  "settings": [
    { "type": "select", "id": "content_source", "label": "Content source", "default": "metafield", "options": [
      { "value": "metafield", "label": "Product metafield (smart.features)" },
      { "value": "blocks", "label": "Section blocks" }
    ]},
    { "type": "range", "id": "max_width", "label": "Max width", "min": 960, "max": 1400, "step": 20, "unit": "px", "default": 1280 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_horizontal", "label": "Padding horizontal", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#f4f8fd" },
    { "type": "text", "id": "section_id", "label": "Section ID", "default": "features" },
    { "type": "textarea", "id": "custom_css", "label": "Custom CSS" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "body", "label": "Body" }
      ]
    }
  ],
  "presets": [{ "name": "CTR PDP Features" }]
}
{% endschema %}
