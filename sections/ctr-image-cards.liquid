{%- comment -%} Image Cards — ctr-image-cards.liquid {%- endcomment -%}
{%- liquid
  assign custom_css      = section.settings.custom_css
  assign section_id_attr = section.settings.section_id
  assign swiper_id       = 'imgc-' | append: section.id
  assign is_carousel     = false
  if section.settings.mobile_layout == 'carousel'
    assign is_carousel = true
  endif
-%}

{% capture selector %}[data-style-id="{{ section.id }}"]{% endcapture %}

{% capture css %}
  & {
    {% if section.settings.bg_color != blank and section.settings.bg_color.alpha != 0 %}
      background-color: {{ section.settings.bg_color }};
    {% endif %}
    padding: {{ section.settings.padding_v }}px {{ section.settings.padding_h }}px;
    box-sizing: border-box;
  }

  & .imgc__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  & .imgc__header {
    text-align: {{ section.settings.header_align }};
    margin-bottom: {{ section.settings.header_gap }}px;
  }

  & .imgc__eyebrow {
    display: block;
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 12px;
    {% if section.settings.eyebrow_color != blank and section.settings.eyebrow_color.alpha != 0 %}
      color: {{ section.settings.eyebrow_color }};
    {% endif %}
  }

  & .imgc__heading {
    font-size: {{ section.settings.heading_size_mobile }}px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    {% if section.settings.heading_color != blank and section.settings.heading_color.alpha != 0 %}
      color: {{ section.settings.heading_color }};
    {% endif %}
  }
  & .imgc__heading h1,
  & .imgc__heading h2,
  & .imgc__heading h3,
  & .imgc__heading p { font-size: inherit; font-weight: inherit; line-height: inherit; color: inherit; margin: 0; }

  /* ─── Card shared styles ─── */
  & .imgc__card {
    display: flex;
    flex-direction: column;
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    {% if section.settings.card_bg != blank and section.settings.card_bg.alpha != 0 %}
      background-color: {{ section.settings.card_bg }};
    {% endif %}
    {% if section.settings.card_shadow %}
      box-shadow: 0 4px 24px rgba(0,0,0,0.07);
    {% endif %}
  }

  & .imgc__card-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: {{ section.settings.card_aspect }};
    object-fit: cover;
  }
  & .imgc__card-image-placeholder {
    display: block;
    width: 100%;
    aspect-ratio: {{ section.settings.card_aspect }};
    background: #d4d8e4;
  }

  & .imgc__card-body {
    padding: {{ section.settings.body_padding }}px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-align: {{ section.settings.card_text_align }};
    flex: 1;
  }

  & .imgc__card-title {
    font-size: {{ section.settings.card_title_size }}px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
    {% if section.settings.card_title_color != blank and section.settings.card_title_color.alpha != 0 %}
      color: {{ section.settings.card_title_color }};
    {% endif %}
  }

  & .imgc__card-desc {
    font-size: {{ section.settings.card_desc_size }}px;
    line-height: 1.55;
    margin: 0;
    {% if section.settings.card_desc_color != blank and section.settings.card_desc_color.alpha != 0 %}
      color: {{ section.settings.card_desc_color }};
    {% endif %}
  }
  & .imgc__card-desc p { margin: 0; }
  & .imgc__card-desc sup {
    font-size: 0.65em;
    vertical-align: super;
    line-height: 0;
    opacity: 0.7;
  }

  /* ─── Grid layout (non-carousel or desktop override) ─── */
  {% if is_carousel %}
    /*
     * Carousel mode:
     * – Mobile  → Swiper JS takes full control (flex + transform)
     * – Desktop → force back to CSS grid with !important overrides
     */
    & .imgc__grid {
      overflow: hidden;
    }

    @media (min-width: 768px) {
      & .imgc__grid .swiper-wrapper {
        display: grid !important;
        grid-template-columns: repeat({{ section.settings.desktop_cols }}, 1fr) !important;
        gap: {{ section.settings.card_gap }}px !important;
        transform: none !important;
        width: auto !important;
      }
      & .imgc__grid .swiper-slide {
        width: auto !important;
        height: auto !important;
      }
    }

  {% else %}
    /*
     * Non-carousel mode:
     * swiper-wrapper is just a plain div — set as CSS grid always.
     */
    & .imgc__grid .swiper-wrapper {
      display: grid;
      grid-template-columns: repeat({{ section.settings.desktop_cols }}, 1fr);
      gap: {{ section.settings.card_gap }}px;
    }
    & .imgc__grid .swiper-slide {
      width: auto;
      height: auto;
    }

    @media (max-width: 767px) {
      {% if section.settings.mobile_layout == '2col' %}
        & .imgc__grid .swiper-wrapper {
          grid-template-columns: repeat(2, 1fr);
        }
      {% else %}
        & .imgc__grid .swiper-wrapper {
          grid-template-columns: 1fr;
        }
      {% endif %}
    }
  {% endif %}

  /* ─── Desktop heading size ─── */
  @media (min-width: 768px) {
    & .imgc__heading {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }
  }

  /* ─── Swiper pagination dots ─── */
  & .swiper-pagination {
    position: relative;
    margin-top: 20px;
    text-align: center;
  }
  & .swiper-pagination-bullet {
    background: {{ section.settings.heading_color | default: '#1a1a1a' }};
    opacity: 0.25;
  }
  & .swiper-pagination-bullet-active {
    opacity: 1;
  }
{% endcapture %}

<style>
  {{ css | append: custom_css | replace: '&', selector | strip_newlines }}
</style>

<div
  data-style-id="{{ section.id }}"
  {% if section_id_attr != blank %}id="{{ section_id_attr }}"{% endif %}
>
  <div class="imgc__inner">

    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="imgc__header">
        {%- if section.settings.eyebrow != blank -%}
          <span class="imgc__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <div class="imgc__heading">{{ section.settings.heading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div
      class="imgc__grid{% if is_carousel %} swiper{% endif %}"
      id="{{ swiper_id }}"
    >
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            <div class="imgc__card swiper-slide" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img
                  class="imgc__card-image"
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.image.alt | default: block.settings.title }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              {%- else -%}
                <div class="imgc__card-image-placeholder"></div>
              {%- endif -%}
              <div class="imgc__card-body">
                {%- if block.settings.title != blank -%}
                  <div class="imgc__card-title">{{ block.settings.title }}</div>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <div class="imgc__card-desc">{{ block.settings.body }}</div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if is_carousel and section.settings.show_dots -%}
        <div class="swiper-pagination"></div>
      {%- endif -%}
    </div>

  </div>
</div>

{%- if is_carousel -%}
<script>
(function () {
  var SWIPER_JS  = {{ 'swiper-bundle.min.js'  | asset_url | json }};
  var SWIPER_CSS = {{ 'swiper-bundle.min.css' | asset_url | json }};
  var swiperId   = {{ swiper_id | json }};
  var spv        = parseFloat({{ section.settings.slides_per_view_mobile | json }}) || 1.2;
  var showDots   = {{ section.settings.show_dots | json }};

  function init() {
    if (window.innerWidth >= 768) return;
    var el = document.getElementById(swiperId);
    if (!el || el._sw) return;
    el._sw = new Swiper(el, {
      slidesPerView: spv,
      spaceBetween: 16,
      grabCursor: true,
      pagination: showDots ? { el: el.querySelector('.swiper-pagination'), clickable: true } : false,
    });
  }

  function onResize() {
    var el = document.getElementById(swiperId);
    if (!el) return;
    if (window.innerWidth >= 768) {
      if (el._sw) { el._sw.destroy(true, true); el._sw = null; }
    } else {
      if (!el._sw) init();
    }
  }
  window.addEventListener('resize', onResize);

  if (window.Swiper) { init(); return; }
  window._ctrSwiperCBs = window._ctrSwiperCBs || [];
  window._ctrSwiperCBs.push(init);
  if (document.getElementById('ctr-swiper-js')) return;
  if (!document.getElementById('ctr-swiper-css')) {
    var l = document.createElement('link');
    l.id = 'ctr-swiper-css'; l.rel = 'stylesheet'; l.href = SWIPER_CSS;
    document.head.appendChild(l);
  }
  var s = document.createElement('script');
  s.id = 'ctr-swiper-js'; s.src = SWIPER_JS;
  s.onload = function () { (window._ctrSwiperCBs || []).forEach(function (fn) { fn(); }); };
  document.head.appendChild(s);
})();
</script>
{%- endif -%}

