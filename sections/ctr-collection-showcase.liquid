{%- comment -%} Collection Showcase Section {%- endcomment -%}
{%- liquid
  assign custom_css      = section.settings.custom_css
  assign section_id_attr = section.settings.section_id
  assign collection      = section.settings.collection
  assign max_products    = section.settings.max_products
-%}

{% capture selector %}[data-style-id="{{ section.id }}"]{% endcapture %}

{% capture css %}
  & {
    {% if section.settings.section_bg != blank and section.settings.section_bg.alpha != 0 %}
      background-color: {{ section.settings.section_bg }};
    {% endif %}
    padding: {{ section.settings.padding_v }}px {{ section.settings.padding_h }}px;
    box-sizing: border-box;
  }

  & .cs__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.layout_gap }}px;
  }

  /* ── Intro Card ── */
  & .cs__intro {
    border-radius: {{ section.settings.intro_radius }}px;
    padding: {{ section.settings.intro_padding_v }}px {{ section.settings.intro_padding_h }}px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 16px;
    {% if section.settings.intro_bg != blank and section.settings.intro_bg.alpha != 0 %}
      background-color: {{ section.settings.intro_bg }};
    {% endif %}
  }

  & .cs__intro-heading {
    font-family: 'Nohemi';
    font-size: {{ section.settings.heading_size_mobile }}px;
    font-weight: 400;
    line-height: 1.1;
    margin: 0;
    {% if section.settings.heading_color != blank and section.settings.heading_color.alpha != 0 %}
      color: {{ section.settings.heading_color }};
    {% endif %}
  }
  & .cs__intro-heading h1,
  & .cs__intro-heading h2,
  & .cs__intro-heading h3,
  & .cs__intro-heading p {
    font-size: inherit; font-weight: inherit; line-height: inherit; color: inherit; margin: 0;
  }

  & .cs__intro-body {
    font-size: {{ section.settings.body_size }}px;
    line-height: 1.6;
    margin: 0;
    {% if section.settings.body_color != blank and section.settings.body_color.alpha != 0 %}
      color: {{ section.settings.body_color }};
    {% endif %}
  }
  & .cs__intro-body p { margin: 0 0 0.75em; }
  & .cs__intro-body p:last-child { margin-bottom: 0; }

  /* Desktop: See All lives inside intro card; hidden on mobile */
  & .cs__see-all-intro { display: none; }

  /* ── Product Grid ── */
  & .cs__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ section.settings.grid_gap }}px;
  }

  /* ── Product Card ── */
  & .cs__card {
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    {% if section.settings.card_bg != blank and section.settings.card_bg.alpha != 0 %}
      background-color: {{ section.settings.card_bg }};
    {% endif %}
  }

  & .cs__card-image-wrap {
    position: relative;
    aspect-ratio: {{ section.settings.image_ratio }};
    overflow: hidden;
    display: block;
    text-decoration: none;
    {% if section.settings.image_bg != blank and section.settings.image_bg.alpha != 0 %}
      background-color: {{ section.settings.image_bg }};
    {% endif %}
  }

  & .cs__card-image-wrap img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 8px;
    box-sizing: border-box;
  }

  & .cs__badge {
    position: absolute;
    top: 10px;
    right: 10px;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 100px;
    line-height: 1.4;
    {% if section.settings.badge_bg != blank and section.settings.badge_bg.alpha != 0 %}
      background-color: {{ section.settings.badge_bg }};
    {% endif %}
    {% if section.settings.badge_color != blank and section.settings.badge_color.alpha != 0 %}
      color: {{ section.settings.badge_color }};
    {% endif %}
  }

  & .cs__card-info {
    padding: {{ section.settings.card_info_padding_v }}px {{ section.settings.card_info_padding_h }}px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
    {% if section.settings.card_info_bg != blank and section.settings.card_info_bg.alpha != 0 %}
      background-color: {{ section.settings.card_info_bg }};
    {% endif %}
  }

  & .cs__card-title {
    font-size: {{ section.settings.title_size }}px;
    font-weight: 500;
    margin: 0;
    line-height: 1.3;
    {% if section.settings.title_color != blank and section.settings.title_color.alpha != 0 %}
      color: {{ section.settings.title_color }};
    {% endif %}
  }

  & .cs__card-stars {
    display: flex;
    align-items: center;
    gap: 3px;
  }
  & .cs__card-stars svg {
    width: {{ section.settings.star_size }}px;
    height: {{ section.settings.star_size }}px;
    flex-shrink: 0;
    {% if section.settings.star_color != blank and section.settings.star_color.alpha != 0 %}
      color: {{ section.settings.star_color }};
    {% endif %}
  }
  & .cs__card-review-count {
    font-size: {{ section.settings.review_count_size }}px;
    margin-left: 2px;
    {% if section.settings.review_count_color != blank and section.settings.review_count_color.alpha != 0 %}
      color: {{ section.settings.review_count_color }};
    {% endif %}
  }

  & .cs__card-price {
    font-size: {{ section.settings.price_size }}px;
    font-weight: 400;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    {% if section.settings.price_color != blank and section.settings.price_color.alpha != 0 %}
      color: {{ section.settings.price_color }};
    {% endif %}
  }
  & .cs__card-price s {
    font-size: {{ section.settings.compare_price_size }}px;
    text-decoration: line-through;
    {% if section.settings.compare_price_color != blank and section.settings.compare_price_color.alpha != 0 %}
      color: {{ section.settings.compare_price_color }};
    {% endif %}
  }

  & .cs__card-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: {{ section.settings.btn_padding_v }}px 16px;
    border-radius: 100px;
    font-size: {{ section.settings.btn_size }}px;
    font-weight: 400;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s;
    box-sizing: border-box;
    margin-top: auto;
    {% if section.settings.btn_bg != blank and section.settings.btn_bg.alpha != 0 %}
      background-color: {{ section.settings.btn_bg }};
    {% endif %}
    {% if section.settings.btn_color != blank and section.settings.btn_color.alpha != 0 %}
      color: {{ section.settings.btn_color }};
    {% endif %}
  }
  & .cs__card-btn:hover { opacity: 0.85; }

  /* ── See All Button ── */
  & .cs__see-all-wrap { display: flex; }
  & .cs__see-all {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 16px 32px;
    border-radius: 100px;
    font-size: {{ section.settings.see_all_size }}px;
    font-weight: 400;
    text-decoration: none;
    transition: opacity 0.2s;
    box-sizing: border-box;
    background-color: transparent;
    {% if section.settings.see_all_color != blank and section.settings.see_all_color.alpha != 0 %}
      color: {{ section.settings.see_all_color }};
    {% endif %}
    {% if section.settings.see_all_border != blank and section.settings.see_all_border.alpha != 0 %}
      border: 1.5px solid {{ section.settings.see_all_border }};
    {% else %}
      border: 1.5px solid currentColor;
    {% endif %}
  }
  & .cs__see-all:hover { opacity: 0.65; }

  /* ── Desktop layout: unified grid (1 intro + N product cols) ── */
  @media (min-width: 768px) {
    & .cs__inner {
      display: grid;
      grid-template-columns: 1fr repeat({{ section.settings.desktop_cols }}, 1fr);
      gap: {{ section.settings.grid_gap }}px;
      align-items: start;
    }
    & .cs__intro {
      align-self: stretch;
      display: flex;
      flex-direction: column;
    }
    & .cs__intro-heading {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }
    & .cs__see-all-intro {
      display: flex;
      margin-top: auto;
      padding-top: 20px;
    }
    & .cs__see-all-wrap { display: none; }
    & .cs__grid-wrap {
      grid-column: span {{ section.settings.desktop_cols }};
    }
    & .cs__grid {
      grid-template-columns: repeat({{ section.settings.desktop_cols }}, 1fr);
    }
  }
{% endcapture %}

<style>
  {{ css | append: custom_css | replace: '&', selector | strip_newlines }}
</style>

<div
  data-style-id="{{ section.id }}"
  {% if section_id_attr != blank %}id="{{ section_id_attr }}"{% endif %}
>
  <div class="cs__inner">

    {%- comment -%} Intro Card {%- endcomment -%}
    <div class="cs__intro">
      {%- if section.settings.heading != blank -%}
        <div class="cs__intro-heading">{{ section.settings.heading }}</div>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="cs__intro-body">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- comment -%} See All — desktop only, inside intro card {%- endcomment -%}
      {%- if section.settings.see_all_label != blank -%}
        <div class="cs__see-all-intro cs__see-all-wrap">
          <a href="{{ section.settings.see_all_url }}" class="cs__see-all">
            {{ section.settings.see_all_label }}
          </a>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Product Grid {%- endcomment -%}
    <div class="cs__grid-wrap">
      <div class="cs__grid">
        {%- if collection != blank -%}
          {%- for product in collection.products limit: max_products -%}
            {%- assign first_variant = product.selected_or_first_available_variant -%}
            {%- assign on_sale = false -%}
            {%- if first_variant.compare_at_price > first_variant.price -%}
              {%- assign on_sale = true -%}
            {%- endif -%}
            {%- comment -%} Rating from metafields (Shopify native or Judge.me) {%- endcomment -%}
            {%- assign rating_value = product.metafields.reviews.rating.value.rating -%}
            {%- assign rating_count = product.metafields.reviews.rating_count.value -%}
            {%- if rating_value == blank -%}
              {%- assign rating_value = product.metafields.judgeme.avg_rating -%}
              {%- assign rating_count = product.metafields.judgeme.review_count -%}
            {%- endif -%}
            {%- assign rating_num   = rating_value | plus: 0 -%}
            {%- assign rating_floor = rating_num | floor -%}
            {%- assign rating_dec   = rating_num | minus: rating_floor -%}
            {%- assign has_half     = false -%}
            {%- if rating_dec >= 0.25 and rating_dec < 0.75 -%}
              {%- assign has_half = true -%}
            {%- endif -%}
            {%- assign half_pos = rating_floor | plus: 1 -%}

            <div class="cs__card">
              <a href="{{ product.url }}" class="cs__card-image-wrap">
                {%- if on_sale and section.settings.show_badge -%}
                  {%- assign discount_pct = first_variant.compare_at_price | minus: first_variant.price | times: 100 | divided_by: first_variant.compare_at_price -%}
                  <div class="cs__badge">{{ discount_pct }}% Off</div>
                {%- endif -%}
                {%- if product.featured_image -%}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | default: product.title }}"
                    loading="lazy"
                    width="{{ product.featured_image.width }}"
                    height="{{ product.featured_image.height }}"
                  >
                {%- endif -%}
              </a>

              <div class="cs__card-info">
                <div class="cs__card-title">{{ product.title }}</div>

                {%- if rating_value != blank -%}
                  <div class="cs__card-stars">
                    {%- for i in (1..5) -%}
                      {%- if i <= rating_floor -%}
                        {%- comment -%} Full star {%- endcomment -%}
                        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                      {%- elsif has_half and i == half_pos -%}
                        {%- comment -%} Half star using clip {%- endcomment -%}
                        <span style="position:relative;display:inline-flex;width:1em;height:1em;flex-shrink:0;">
                          <svg style="position:absolute;inset:0;" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                          </svg>
                          <svg style="position:absolute;inset:0;clip-path:inset(0 50% 0 0);" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                          </svg>
                        </span>
                      {%- else -%}
                        {%- comment -%} Empty star {%- endcomment -%}
                        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if rating_count != blank -%}
                      <span class="cs__card-review-count">({{ rating_count }})</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}

                <div class="cs__card-price">
                  {{ first_variant.price | money }}
                  {%- if on_sale -%}
                    <s>{{ first_variant.compare_at_price | money }}</s>
                  {%- endif -%}
                </div>

                <a href="{{ product.url }}" class="cs__card-btn">{{ section.settings.btn_label }}</a>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Placeholder when no collection is selected {%- endcomment -%}
          {%- for i in (1..4) -%}
            <div class="cs__card">
              <div class="cs__card-image-wrap">
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
              <div class="cs__card-info">
                <div class="cs__card-title">Product title</div>
                <div class="cs__card-price">$25.00</div>
                <a href="#" class="cs__card-btn">{{ section.settings.btn_label }}</a>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} See All — mobile only, below grid {%- endcomment -%}
    {%- if section.settings.see_all_label != blank -%}
      <div class="cs__see-all-wrap">
        <a href="{{ section.settings.see_all_url }}" class="cs__see-all">
          {{ section.settings.see_all_label }}
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Collection Showcase",
  "settings": [
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Max products to show",
      "default": 6,
      "min": 2,
      "max": 12,
      "step": 1
    },
    {
      "type": "paragraph",
      "content": "t:all.empty_char"
    },
    {
      "type": "header",
      "content": "Intro Card"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>explore our collection</p>"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size — Desktop (px)",
      "default": 48,
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size — Mobile (px)",
      "default": 36,
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>Every Breathewave product is designed to support better breathing and whole-body wellness. Explore the full lineup and find what fits your flow.</p>"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body text size (px)",
      "default": 15,
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "paragraph",
      "content": "t:all.empty_char"
    },
    {
      "type": "header",
      "content": "See All Button"
    },
    {
      "type": "text",
      "id": "see_all_label",
      "label": "Button label",
      "default": "See All →"
    },
    {
      "type": "url",
      "id": "see_all_url",
      "label": "Button URL"
    },
    {
      "type": "range",
      "id": "see_all_size",
      "label": "Button font size (px)",
      "default": 16,
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "paragraph",
      "content": "t:all.empty_char"
    },
    {
      "type": "header",
      "content": "Product Cards"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Card button label",
      "default": "View details"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show sale badge",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "default": "1 / 1",
      "options": [
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "16 / 9", "label": "Wide (16:9)" }
      ]
    },
    {
      "type": "paragraph",
      "content": "t:all.empty_char"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "intro_col_width",
      "label": "Intro column width — Desktop (%)",
      "default": 30,
      "min": 20,
      "max": 50,
      "step": 1,
      "unit": "%"
    },
    {
      "type": "select",
      "id": "desktop_cols",
      "label": "Product columns — Desktop",
      "default": "3",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ]
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap (px)",
      "default": 16,
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "layout_gap",
      "label": "Intro-to-grid gap — Mobile (px)",
      "default": 20,
      "min": 8,
      "max": 60,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "col_gap",
      "label": "Intro-to-grid gap — Desktop (px)",
      "default": 40,
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width (px)",
      "default": 1200,
      "min": 800,
      "max": 1800,
      "step": 40,
      "unit": "px"
    },
    {
      "type": "paragraph",
      "content": "t:all.empty_char"
    },
    {
      "type": "header",
      "content": "Section Wrapper"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "section_bg",
      "label": "Section background"
    },
    {
      "type": "range",
      "id": "padding_v",
      "label": "Padding vertical (px)",
      "default": 40,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_h",
      "label": "Padding horizontal (px)",
      "default": 20,
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "paragraph",
      "content": "t:all.empty_char"
    },
    {
      "type": "header",
      "content": "Intro Card Style"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "intro_bg",
      "label": "Background color",
      "default": "#eef1f6"
    },
    {
      "type": "range",
      "id": "intro_radius",
      "label": "Border radius (px)",
      "default": 20,
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "intro_padding_v",
