{%- comment -%} Collection Showcase - ctr-collection-showcase.liquid {%- endcomment -%}
{%- liquid
  assign section_id_attr = section.settings.section_id
  assign custom_css = section.settings.custom_css
  assign max_products = section.settings.max_products
  assign product_blocks = section.blocks | where: 'type', 'product'
  assign mobile_is_scroll = false

  if section.settings.mobile_layout == 'horizontal_scroll'
    assign mobile_is_scroll = true
  endif
-%}

{% capture selector %}[data-style-id="{{ section.id }}"]{% endcapture %}

{% capture css %}
  & {
    {% if section.settings.bg_color != blank and section.settings.bg_color.alpha != 0 %}
      background-color: {{ section.settings.bg_color }};
    {% endif %}
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;
    box-sizing: border-box;
  }

  & .ccs__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  & .ccs__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.desktop_columns }}, minmax(0, 1fr));
    gap: {{ section.settings.card_gap }}px;
    align-items: stretch;
  }

  & .ccs__item {
    min-width: 0;
  }

  & .ccs__intro {
    order: -1;
    display: flex;
    flex-direction: column;
    min-height: {{ section.settings.intro_min_height }}px;
    padding: {{ section.settings.intro_padding }}px;
    border-radius: {{ section.settings.card_radius }}px;
    box-sizing: border-box;
    overflow: hidden;
    {% if section.settings.card_bg != blank and section.settings.card_bg.alpha != 0 %}
      background-color: {{ section.settings.card_bg }};
    {% endif %}
    {% if section.settings.text_color != blank and section.settings.text_color.alpha != 0 %}
      color: {{ section.settings.text_color }};
    {% endif %}
  }

  & .ccs__intro-content {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.intro_text_gap }}px;
  }

  & .ccs__heading {
    margin: 0;
    font-size: {{ section.settings.heading_size_desktop }}px;
    font-weight: 300;
    line-height: 1.06;
  }

  & .ccs__heading p,
  & .ccs__heading h1,
  & .ccs__heading h2,
  & .ccs__heading h3 {
    display: inline;
    margin: 0;
    font: inherit;
    color: inherit;
  }

  & .ccs__body {
    max-width: {{ section.settings.body_max_width }}px;
    font-size: {{ section.settings.body_size_desktop }}px;
    line-height: 1.45;
  }

  & .ccs__body p {
    margin: 0 0 1em;
  }

  & .ccs__body p:last-child {
    margin-bottom: 0;
  }

  & .ccs__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    min-height: {{ section.settings.cta_height }}px;
    margin-top: auto;
    padding: 12px 24px;
    border: {{ section.settings.cta_border_width }}px solid currentColor;
    border-radius: 999px;
    color: inherit;
    font-size: {{ section.settings.cta_size }}px;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, opacity 0.2s ease;
  }

  & .ccs__cta:hover {
    {% if section.settings.cta_hover_bg != blank and section.settings.cta_hover_bg.alpha != 0 %}
      background-color: {{ section.settings.cta_hover_bg }};
    {% endif %}
    {% if section.settings.cta_hover_color != blank and section.settings.cta_hover_color.alpha != 0 %}
      color: {{ section.settings.cta_hover_color }};
    {% endif %}
    opacity: 0.9;
  }

  {% assign hidden_product_index = max_products | plus: 2 %}
  & .ccs__grid > .ccs__product-card:nth-of-type(n + {{ hidden_product_index }}) {
    display: none;
  }

  & .ccs__product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    text-decoration: none;
    {% if section.settings.card_bg != blank and section.settings.card_bg.alpha != 0 %}
      background-color: {{ section.settings.card_bg }};
    {% endif %}
  }

  & .ccs__product-media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: {{ section.settings.product_media_height }}px;
    padding: 42px 28px 24px;
    background: {{ section.settings.product_media_bg }};
    color: inherit;
    text-decoration: none;
  }

  & .ccs__product-image {
    display: block;
    width: 78%;
    max-width: 250px;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 28px 18px rgba(15, 15, 15, 0.2));
  }

  & .ccs__product-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 78%;
    max-width: 250px;
    aspect-ratio: 1;
    color: rgba(15, 15, 15, 0.18);
  }

  & .ccs__product-placeholder svg {
    width: 100%;
    height: 100%;
  }

  & .ccs__sale-badge {
    position: absolute;
    top: 14px;
    right: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 10px 20px;
    border-radius: 10px;
    background: #ffffff;
    color: {{ section.settings.sale_badge_color }};
    font-size: {{ section.settings.sale_badge_size }}px;
    font-weight: 700;
    line-height: 1;
  }

  & .ccs__product-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: {{ section.settings.product_body_padding }}px;
    text-align: center;
  }

  & .ccs__product-title {
    color: inherit;
    font-size: {{ section.settings.product_title_size }}px;
    font-weight: 400;
    line-height: 1.2;
    text-decoration: none;
    text-transform: lowercase;
  }

  & .ccs__rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 22px;
    color: {{ section.settings.rating_color }};
    font-size: {{ section.settings.rating_size }}px;
    line-height: 1;
  }

  & .ccs__stars {
    letter-spacing: 1px;
  }

  & .ccs__rating-count {
    color: {{ section.settings.rating_count_color }};
    font-size: {{ section.settings.rating_count_size }}px;
  }

  & .ccs__price {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 10px;
    color: inherit;
    font-size: {{ section.settings.price_size }}px;
    font-weight: 700;
    line-height: 1.2;
  }

  & .ccs__price s {
    font-weight: 400;
    opacity: 0.8;
  }

  & .ccs__product-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: {{ section.settings.product_button_height }}px;
    margin-top: auto;
    padding: 12px 24px;
    border-radius: 999px;
    background: {{ section.settings.product_button_bg }};
    color: {{ section.settings.product_button_color }};
    font-size: {{ section.settings.product_button_size }}px;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  & .ccs__product-button:hover {
    opacity: 0.85;
  }

  @media (max-width: 749px) {
    & {
      padding: {{ section.settings.padding_top_mobile }}px {{ section.settings.padding_horizontal_mobile }}px {{ section.settings.padding_bottom_mobile }}px;
    }

    & .ccs__grid {
      gap: {{ section.settings.card_gap_mobile }}px;
    }

    {% if mobile_is_scroll %}
      & .ccs__grid {
        display: flex;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x proximity;
        scroll-padding-inline: {{ section.settings.padding_horizontal_mobile }}px;
        margin-inline: -{{ section.settings.padding_horizontal_mobile }}px;
        padding-inline: {{ section.settings.padding_horizontal_mobile }}px;
        padding-bottom: 6px;
        -webkit-overflow-scrolling: touch;
      }

      & .ccs__grid::-webkit-scrollbar {
        display: none;
      }

      & .ccs__item {
        flex: 0 0 {{ section.settings.mobile_card_width }}%;
        scroll-snap-align: start;
      }

      & .ccs__product-card,
      & .ccs__intro {
        flex: 0 0 {{ section.settings.mobile_card_width }}%;
        scroll-snap-align: start;
      }
    {% else %}
      & .ccs__grid {
        grid-template-columns: repeat({{ section.settings.mobile_columns }}, minmax(0, 1fr));
      }
    {% endif %}

    & .ccs__intro {
      min-height: {{ section.settings.intro_min_height_mobile }}px;
      padding: {{ section.settings.intro_padding_mobile }}px;
    }

    & .ccs__heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    & .ccs__body {
      font-size: {{ section.settings.body_size_mobile }}px;
    }

    & .ccs__product-media {
      min-height: {{ section.settings.product_media_height_mobile }}px;
      padding: 32px 20px 20px;
    }

    & .ccs__product-body {
      padding: {{ section.settings.product_body_padding_mobile }}px;
    }
  }
{% endcapture %}

<style>
  {{ css | append: custom_css | replace: '&', selector | strip_newlines }}
</style>

<div
  data-style-id="{{ section.id }}"
  {% if section_id_attr != blank %}id="{{ section_id_attr }}"{% endif %}
>
  <div class="ccs__inner">
    <div class="ccs__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'intro' -%}
            <div class="ccs__intro" {{ block.shopify_attributes }}>
              <div class="ccs__intro-content">
                {%- if block.settings.heading != blank -%}
                  <div class="ccs__heading">{{ block.settings.heading }}</div>
                {%- endif -%}

                {%- if block.settings.body != blank -%}
                  <div class="ccs__body">{{ block.settings.body }}</div>
                {%- endif -%}
              </div>

              {%- if block.settings.cta_label != blank and block.settings.cta_url != blank -%}
                <a class="ccs__cta" href="{{ block.settings.cta_url }}">
                  <span>{{ block.settings.cta_label }}</span>
                  <span aria-hidden="true">&rarr;</span>
                </a>
              {%- endif -%}
            </div>

          {%- when 'product' -%}
            {%- liquid
              assign product = block.settings.product
              assign product_url = '#'
              assign rating_count = block.settings.rating_count

              if product != blank
                assign product_url = product.url
              endif

              if rating_count == blank and product != blank
                assign rating_count = product.metafields.reviews.rating_count
              endif
            -%}

            <div class="ccs__product-card" {{ block.shopify_attributes }}>
              <a class="ccs__product-media" href="{{ product_url }}" aria-label="{{ product.title | escape }}">
                {%- if product.featured_media.preview_image != blank -%}
                  {{
                    product.featured_media.preview_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 450, 600, 750, 900',
                      sizes: '(min-width: 990px) 25vw, 82vw',
                      class: 'ccs__product-image'
                  }}
                {%- else -%}
                  <div class="ccs__product-placeholder">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {%- endif -%}

                {%- if block.settings.show_sale_badge and product.compare_at_price > product.price -%}
                  {%- liquid
                    assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price
                  -%}
                  <span class="ccs__sale-badge">{{ discount }}% Off</span>
                {%- endif -%}
              </a>

              <div class="ccs__product-body">
                <a class="ccs__product-title" href="{{ product_url }}">
                  {%- if product != blank -%}
                    {{ product.title }}
                  {%- else -%}
                    Product title
                  {%- endif -%}
                </a>

                {%- if block.settings.show_rating -%}
                  <div class="ccs__rating" aria-label="Product rating">
                    <span class="ccs__stars" aria-hidden="true">★★★★★</span>
                    {%- if rating_count != blank -%}
                      <span class="ccs__rating-count">({{ rating_count }})</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}

                <div class="ccs__price">
                  {%- if product != blank -%}
                    <span>{{ product.price | money }}</span>
                    {%- if product.compare_at_price > product.price -%}
                      <s>{{ product.compare_at_price | money }}</s>
                    {%- endif -%}
                  {%- else -%}
                    <span>{{ 2500 | money }}</span>
                  {%- endif -%}
                </div>

                {%- if block.settings.button_label != blank -%}
                  <a class="ccs__product-button" href="{{ product_url }}">{{ block.settings.button_label }}</a>
                {%- endif -%}
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}

      {%- if product_blocks.size == 0 -%}
        {%- for i in (1..max_products) -%}
          <div class="ccs__product-card">
            <div class="ccs__product-media">
              <div class="ccs__product-placeholder">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            </div>
            <div class="ccs__product-body">
              <span class="ccs__product-title">Product title</span>
              <div class="ccs__rating">
                <span class="ccs__stars" aria-hidden="true">★★★★★</span>
                <span class="ccs__rating-count">(18)</span>
              </div>
              <div class="ccs__price">
                <span>{{ 2500 | money }}</span>
              </div>
              <span class="ccs__product-button">View details</span>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CTR Collection Showcase",
  "class": "ctr-collection-showcase",
  "blocks": [
    {
      "type": "intro",
      "name": "Intro card",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "heading",
          "label": "Heading",
          "default": "<p>explore our collection</p>"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p>Every Breathewave product is designed to support better breathing and whole-body wellness. Explore the full lineup and find what fits your flow.</p>"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA label",
          "default": "See All"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "CTA link"
        }
      ]
    },
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "View details"
        },
        {
          "type": "checkbox",
          "id": "show_rating",
          "label": "Show rating",
          "default": true
        },
        {
          "type": "text",
          "id": "rating_count",
          "label": "Rating count override"
        },
        {
          "type": "checkbox",
          "id": "show_sale_badge",
          "label": "Show sale badge",
          "default": true
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Max products to show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "horizontal_scroll",
          "label": "Horizontal scroll"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ],
      "default": "horizontal_scroll"
    },
    {
      "type": "range",
      "id": "mobile_card_width",
      "label": "Mobile card width",
      "min": 70,
      "max": 92,
      "step": 1,
      "unit": "%",
      "default": 82,
      "visible_if": "{{ section.settings.mobile_layout == 'horizontal_scroll' }}"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile grid columns",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1",
      "visible_if": "{{ section.settings.mobile_layout == 'grid' }}"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 960,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1680
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "card_gap_mobile",
      "label": "Mobile card gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "intro_min_height",
      "label": "Intro min height",
      "min": 320,
      "max": 760,
      "step": 10,
      "unit": "px",
      "default": 520
    },
    {
      "type": "range",
      "id": "intro_min_height_mobile",
      "label": "Mobile intro min height",
      "min": 280,
      "max": 620,
      "step": 10,
      "unit": "px",
      "default": 420
    },
    {
      "type": "range",
      "id": "intro_padding",
      "label": "Intro padding",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "intro_padding_mobile",
      "label": "Mobile intro padding",
      "min": 16,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "intro_text_gap",
      "label": "Intro text gap",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size desktop",
      "min": 28,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 54
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size mobile",
      "min": 28,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "body_size_desktop",
      "label": "Body size desktop",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "body_size_mobile",
      "label": "Body size mobile",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "body_max_width",
      "label": "Body max width",
      "min": 220,
      "max": 560,
      "step": 10,
      "unit": "px",
      "default": 360
    },
    {
      "type": "header",
      "content": "CTA"
    },
    {
      "type": "range",
      "id": "cta_height",
      "label": "CTA height",
      "min": 44,
      "max": 90,
      "step": 2,
      "unit": "px",
      "default": 66
    },
    {
      "type": "range",
      "id": "cta_size",
      "label": "CTA font size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    { 
      "type": "range",
      "id": "cta_border_width",
      "label": "CTA border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "color",
      "id": "cta_hover_bg",
      "label": "CTA hover background",
      "default": "#0f0f0f"
    },
    {
      "type": "color",
      "id": "cta_hover_color",
      "label": "CTA hover text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Product cards"
    },
    {
      "type": "range",
      "id": "product_media_height",
      "label": "Product media height",
      "min": 220,
      "max": 520,
      "step": 10,
      "unit": "px",
      "default": 390
    },
    {
      "type": "range",
      "id": "product_media_height_mobile",
      "label": "Mobile product media height",
      "min": 200,
      "max": 420,
      "step": 10,
      "unit": "px",
      "default": 320
    },
    {
      "type": "range",
      "id": "product_body_padding",
      "label": "Product body padding",
      "min": 18,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "product_body_padding_mobile",
      "label": "Mobile product body padding",
      "min": 16,
      "max": 44,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "product_title_size",
      "label": "Product title size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "rating_size",
      "label": "Rating star size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "rating_count_size",
      "label": "Rating count size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 18
